{
  "name": "express-supabase-by-example",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:css\" \"nodemon ./bin/www\"",
    "start": "node ./bin/www",
    "dev:css": "tailwindcss -w -i ./public/stylesheets/tailwind.css -o public/stylesheets/style.css",
    "build": "npm run build:css",
    "build:css": "tailwindcss -m -i ./public/stylesheets/tailwind.css -o public/stylesheets/app.css",
    "test": "playwright test",
    "s:start": "supabase start",
    "s:stop": "supabase stop"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "cookie-parser": "~1.4.7",
    "daisyui": "^5.7.50",
    "debug": "~4.4.3",
    "dotenv": "^18.0.10",
    "express": "~5.3.0",
    "express-flash": "^0.0.2",
    "express-session": "^1.19.0",
    "http-errors": "~2.0.1",
    "morgan": "~1.12.1",
    "pug": "3.0.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/tcp-port-used": "^1.0.4",
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.14",
    "supabase": "3.1.0",
    "tailwindcss": "^4.3.5",
    "tcp-port-used": "^1.0.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
