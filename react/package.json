{
  "name": "react-supabase-by-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:css\" \"vite\"",
    "dev:css": "tailwindcss -w -i ./src/tailwind.css -o src/app.css",
    "build": "npm run build:css && tsc && vite build",
    "build:css": "tailwindcss -m -i ./src/tailwind.css -o src/app.css",
    "preview": "vite preview",
    "test": "playwright test",
    "s:start": "supabase start",
    "s:stop": "supabase stop"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "daisyui": "^5.7.50",
    "just-safe-get": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tcp-port-used": "^1.0.4",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "supabase": "3.1.0",
    "tailwindcss": "^4.3.5",
    "tcp-port-used": "^1.0.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "trustedDependencies": [
    "supabase"
  ],
  "engines": {
    "node": ">=22.22.0"
  }
}
